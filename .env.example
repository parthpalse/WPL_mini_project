SECRET_KEY=replace-me-in-production

# ── Database ─────────────────────────────────────────────────────────────
# Local MongoDB (default if unset):
MONGODB_URI=mongodb://localhost:27017/bankease
# MongoDB Atlas (Atlas -> Connect -> Drivers -> Python). Keep "/bankease" before the "?":
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bankease?retryWrites=true&w=majority

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
FLASK_ENV=development

# ── Market Data (Finnhub) ──────────────────────────────────────────────
FINNHUB_API_KEY=           # required — get free key at https://finnhub.io

# ── Chatbot (open-source LLM via any OpenAI-compatible API) ────────────
# Local Ollama (default, no key needed — run `ollama pull llama3.2`):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=
# Hosted (needed on Render) — Groq free tier serving open-weight models, key from https://console.groq.com/keys:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=gsk_...
LLM_MAX_TOKENS=512         # keep responses tight
