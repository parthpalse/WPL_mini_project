SECRET_KEY=replace-me-in-production

# ── Database ─────────────────────────────────────────────────────────────
# Local development default (zero-setup):
DATABASE_URL=sqlite:///bankease.db
# Supabase / PostgreSQL cloud connection (copy from Supabase -> Project Settings -> Database):
# DATABASE_URL=postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2
FLASK_ENV=development

# ── Market Data (Finnhub) ──────────────────────────────────────────────
FINNHUB_API_KEY=           # required — get free key at https://finnhub.io

# ── Chatbot (Claude via Anthropic) ─────────────────────────────────────
ANTHROPIC_API_KEY=         # required — https://console.anthropic.com
CLAUDE_CHAT_MODEL=claude-3-5-haiku-20241022   # Haiku for speed; Sonnet for depth
CLAUDE_MAX_TOKENS=512      # keep responses tight
